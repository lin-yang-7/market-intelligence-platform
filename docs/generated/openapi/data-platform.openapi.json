                  "type": "string",
                  "minLength": 3,
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "title": "Eventaction"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
