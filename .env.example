APP_ENV=local
LOG_LEVEL=INFO
SECRET_ENCRYPTION_KEY=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=market_intelligence
MYSQL_USER=mip
MYSQL_PASSWORD=mip_password

REDIS_URL=redis://localhost:6379/0

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MARKET_TICKER=market.ticker
SUPPORTED_EXCHANGES=binance,bybit,okx,mock
API_KEYS=
# Sensitive values can be plaintext for local development or enc:v1 encrypted
# values generated with scripts/encrypt_secret.py.
ANONYMOUS_RATE_LIMIT_PER_MINUTE=100
API_KEY_RATE_LIMIT_PER_MINUTE=1000
REPOSITORY_BACKEND=memory

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=market_intelligence
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

FEATURE_STORE_SERVICE_URL=http://localhost:8016
AI_SERVICE_URL=http://localhost:8010
SCORE_SERVICE_URL=http://localhost:8014
SCORE_SERVICE_ENABLED=false
AI_SCORING_ENABLED=false
DATA_PLATFORM_STORAGE_BACKEND=memory
DATA_PLATFORM_KAFKA_TOPICS=market.ticker,market.kline,market.trade,feature.updated,ranking.updated,signal.created
DATA_PLATFORM_KAFKA_GROUP_ID=data-platform

NOTIFICATION_SERVICE_URL=http://localhost:8012
WEBSOCKET_SERVICE_URL=http://localhost:8008
RULE_SERVICE_URL=http://localhost:8015
NOTIFICATION_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
USER_SERVICE_URL=http://localhost:8013
HISTORY_SERVICE_URL=http://localhost:8009
# Required for Docker and every non-local deployment. Generate a unique 32-byte-or-longer secret.
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
ACCESS_TOKEN_TTL_SECONDS=3600
ADMIN_EMAILS=admin@example.com

COLLECTOR_EXCHANGE=binance
COLLECTOR_SYMBOLS=BTCUSDT,ETHUSDT
COLLECTOR_INTERVAL_SECONDS=5
# 0 keeps COLLECTOR_SYMBOLS only; a positive value polls that many highest-volume USDT tickers.
COLLECTOR_AUTO_TOP_SYMBOLS=0
# 0 keeps derivatives at COLLECTOR_SYMBOLS; a positive value uses the most-liquid USDT pairs.
COLLECTOR_DERIVATIVES_TOP_SYMBOLS=0
COLLECTOR_DERIVATIVES_INTERVAL_SECONDS=60
COLLECTOR_DERIVATIVE_REQUEST_DELAY_SECONDS=0.1

# Set to true to run the built-in full-market backfill scheduler once per UTC day.
HISTORICAL_BACKFILL_ENABLED=false
HISTORICAL_BACKFILL_HOUR_UTC=2
HISTORICAL_BACKFILL_DAYS=2
HISTORICAL_BACKFILL_INTERVAL=1h
HISTORICAL_BACKFILL_POLL_SECONDS=60
