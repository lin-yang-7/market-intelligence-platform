  "components": {
    "schemas": {
      "FeatureDefinitionRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Name"
          },
          "category": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Category"
          },
          "version": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Version",
            "default": "v1"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "title": "Description",
            "default": ""
          },
          "formula": {
            "type": "string",
            "maxLength": 1000,
            "title": "Formula",
            "default": ""
          },
          "dataSource": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Datasource",
            "default": "feature-service"
          },
          "updateFrequency": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Updatefrequency",
            "default": "realtime"
          },
          "owner": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Owner",
            "default": "system"
          },
          "dependencies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dependencies"
          }
        },
        "type": "object",
        "required": [
          "name",
          "category"
        ],
        "title": "FeatureDefinitionRequest"
      },
      "FeatureValueWrite": {
        "properties": {
          "symbol": {
            "type": "string",
            "maxLength": 30,
            "minLength": 3,
            "title": "Symbol"
          },
          "exchange": {
            "type": "string",
            "maxLength": 30,
            "minLength": 2,
            "title": "Exchange",
            "default": "binance"
          },
          "feature": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Feature"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "version": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Version",
            "default": "v1"
          },
          "timestamp": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "feature",
          "value",
          "timestamp"
        ],
        "title": "FeatureValueWrite"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}