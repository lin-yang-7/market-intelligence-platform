# Copy this file to .env before launching the Lite stack.
INTERNAL_SERVICE_TOKEN=replace-with-a-random-48-byte-token
LITE_BIND_ADDRESS=127.0.0.1
LITE_FRONTEND_PORT=18080
COLLECTOR_SYMBOLS=BTCUSDT,ETHUSDT
COLLECTOR_INTERVAL_SECONDS=5
COLLECTOR_AUTO_TOP_SYMBOLS=50
COLLECTOR_DERIVATIVES_TOP_SYMBOLS=20
COLLECTOR_DERIVATIVES_INTERVAL_SECONDS=60
HISTORICAL_BACKFILL_ENABLED=true
HISTORICAL_BACKFILL_HOUR_UTC=2
HISTORICAL_BACKFILL_DAYS=2
HISTORICAL_BACKFILL_INTERVAL=1h
SIGNAL_GENERATOR_INTERVAL_SECONDS=60
RANKING_MONITOR_INTERVAL_SECONDS=60
