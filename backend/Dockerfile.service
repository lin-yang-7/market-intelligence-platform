FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/backend:/app/backend/common:/app/ai-engine:/app/data-platform

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend /app/backend
COPY ai-engine /app/ai-engine
COPY data-platform /app/data-platform
COPY scripts /app/scripts

CMD ["uvicorn", "services.market_service.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
