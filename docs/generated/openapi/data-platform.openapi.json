        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "LineageRequest"
      },
      "PipelineEvent": {
        "properties": {
          "event_type": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Event Type"
          },
          "timestamp": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Timestamp"
          },
          "source": {
            "type": "string",
            "maxLength": 64,
            "minLength": 2,
